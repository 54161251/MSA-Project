# Copy this file to .env and fill in what you need. Never commit .env.

# LLM provider:
#   offline            (default) deterministic logic, no key needed
#   anthropic          Claude; set ANTHROPIC_API_KEY and MSA_LLM_MODEL
#   openai_compatible  anything with an OpenAI-style API; set MSA_LLM_BASE_URL, MSA_LLM_MODEL
#                      and MSA_LLM_API_KEY (not needed for Ollama). Examples:
#                        Ollama (local, free):  http://localhost:11434/v1   model e.g. qwen2.5:7b
#                        Gemini (free tier):    https://generativelanguage.googleapis.com/v1beta/openai
#                        Groq (free tier):      https://api.groq.com/openai/v1
MSA_LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
# Check the model name against your provider's docs before using it.
MSA_LLM_MODEL=claude-sonnet-5-5
MSA_LLM_BASE_URL=
MSA_LLM_API_KEY=
# Seconds to wait between calls (free tiers: 60 / requests-per-minute, e.g. 7 for 10 RPM)
MSA_LLM_MIN_INTERVAL=0
# Save every prompt and raw model reply to var/llm_debug/ (for troubleshooting)
MSA_LLM_DEBUG=off

# Database (SQLite file in var/ by default)
MSA_DB_URL=sqlite:///var/msa.db
MSA_CHECKPOINT_DB=var/checkpoints.db
MSA_TELEMETRY_DB=sqlite:///var/telemetry.db

# First staff account, created by `python -m msa.cli seed`
MSA_ADMIN_NAME=Shop Staff
MSA_ADMIN_EMAIL=staff@example.org
MSA_ADMIN_PASSWORD=change-me-now

# API location used by the Streamlit UI
MSA_API_URL=http://127.0.0.1:8000

# Run the daily maintenance check inside the API process (on/off) and at what hour
MSA_SCHEDULER=on
MSA_DAILY_HOUR=7
